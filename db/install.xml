<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="enrol/prereq2/db" VERSION="20180625" COMMENT="Enrol prereq2 plugin tables"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">

    <TABLES>
        <TABLE NAME="enrol_prereq2" COMMENT="Stores prerequisite course for each course">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="The course that has a prerequisite"/>
                <FIELD NAME="prereqid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="The prerequisite course"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
            </FIELDS>

            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="courseid_fk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
                <KEY NAME="prereqid_fk" TYPE="foreign" FIELDS="prereqid" REFTABLE="course" REFFIELDS="id"/>
            </KEYS>

            <INDEXES>
                <INDEX NAME="courseid_idx" UNIQUE="true" FIELDS="courseid"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
